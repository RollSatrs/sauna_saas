{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Касса",
  "version": "0.1.0",
  "identifier": "kz.sauna.pos",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Касса",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "windows": {
      "nsis": {
        "languages": ["Russian"],
        "installMode": "perMachine"
      }
    }
  }
}
